{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "Short plain-text question title."
          },
          "question_number": {
            "type": "string",
            "description": "Visible source question number, when present."
          },
          "question_type": {
            "type": "string",
            "enum": ["mcq", "fill_blank", "frq", "mixed"]
          },
          "difficulty_rating": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1000
          },
          "content_html": {
            "type": "string",
            "description": "Sanitization-friendly HTML containing the complete question."
          },
          "content_source": {
            "type": "string",
            "description": "Editable Markdown and LaTeX source for the question."
          },
          "solution_html": {
            "type": "string",
            "description": "Sanitization-friendly solution HTML when supported by the source."
          },
          "solution_source": {
            "type": "string",
            "description": "Editable solution source when supported by the source."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "content_html": { "type": "string" },
                "content_source": { "type": "string" }
              },
              "required": ["id", "label", "content_html"]
            }
          },
          "answer_spec": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["mcq", "fill_blank", "frq", "mixed"]
              },
              "correct_option_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "allow_multiple": { "type": "boolean" },
              "final_answers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "accepted_answers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "equivalence": {
                "type": "string",
                "enum": ["exact", "numeric", "math"]
              },
              "numeric_tolerance": {
                "type": "number",
                "minimum": 0
              },
              "case_sensitive": { "type": "boolean" },
              "grading_mode": {
                "type": "string",
                "enum": ["manual_or_ai"]
              }
            }
          },
          "tag_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "page_refs": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "asset_placeholders": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "alt": { "type": "string" },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "placeholder": { "type": "string" },
                "bbox": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 1 },
                    "y": { "type": "number", "minimum": 0, "maximum": 1 },
                    "width": { "type": "number", "minimum": 0, "maximum": 1 },
                    "height": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "required": ["x", "y", "width", "height"]
                }
              },
              "required": ["page", "placeholder", "bbox"]
            }
          }
        },
        "required": ["title", "question_type", "content_html"]
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["questions", "warnings"]
}
