{
  "name": "o2i-web-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "perf:audit": "node scripts/site-performance-audit.mjs",
    "perf:budget": "node scripts/performance-budget-smoke.mjs",
    "deadcode:audit": "knip --reporter compact",
    "lint": "node scripts/check-math-content-usage.mjs && node ./node_modules/eslint/bin/eslint.js .",
    "lint:math-content": "node scripts/check-math-content-usage.mjs",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-all.mjs",
    "smoke:practice-thread-cache": "node scripts/practice-thread-cache-refactor-smoke.mjs",
    "smoke:import-json-latex": "node scripts/import-json-latex-repair-smoke.mjs",
    "smoke:rls": "node scripts/supabase-rls-smoke.mjs",
    "smoke:assets-security": "node scripts/question-assets-security-smoke.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "katex": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.0.227",
    "react": "latest",
    "react-dom": "latest",
    "sanitize-html": "^2.17.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "latest",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "knip": "^6.21.0",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "latest",
    "typescript": "latest"
  }
}
