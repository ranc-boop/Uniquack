NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production for fail-closed POST origin validation and redirects.
# Set TRUST_PROXY_HEADERS=1 only when the ingress removes and rewrites both
# X-Forwarded-Host and X-Forwarded-Proto.
SITE_URL=
TRUST_PROXY_HEADERS=0

# Server-only. Dedicated AI provider gateway token used by Next.js server
# actions/routes to access provider profiles through limited Supabase RPCs.
# Store only its SHA-256 hash in private.ai_provider_gateway_token_hashes.
# Never prefix this with NEXT_PUBLIC_.
AI_PROVIDER_GATEWAY_TOKEN=

# Required before saving AI provider API keys in /admin/ai-settings.
# Use a long random value; the app derives an AES-256-GCM key from it.
AI_PROVIDER_ENCRYPTION_KEY=

# Optional local/smoke-test escape hatch. In production, mock://ai-pdf-import
# is rejected unless this is explicitly set to true.
ENABLE_MOCK_AI_PROVIDER=

# Optional local debugging. When true, AI PDF import writes complete provider
# request context and response/error JSON to log/llm/ai_import. Never expose
# this directory publicly.
AI_IMPORT_LLM_DEBUG_LOGS=

# Optional local debugging. When true, Practice Agent writes full model
# requests/responses and tool payloads to log/llm/practice_agent. Never expose
# this directory publicly.
PRACTICE_AGENT_FULL_CALL_LOGS=

# Optional: used by npm run smoke:rls
TEST_STUDENT_USERNAME=
TEST_STUDENT_PASSWORD=
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
TEST_SUPER_ADMIN_USERNAME=
TEST_SUPER_ADMIN_PASSWORD=
